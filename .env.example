# Copy to .env (git-ignored) and replace every placeholder. Never commit .env.
# Pass it to Compose explicitly: docker compose --env-file .env -f deploy/compose.yaml ...

# Password of the local PostgreSQL fixture (compose service `postgres`, user probe, db feasibility).
# Any local value works; it is set when the database volume is first created.
TON_SENTINEL_PG_PASSWORD=change-me-local-only

# Optional: a TON Center v3 compatible indexer for live reads. The key is sent only to this host,
# as the X-Api-Key header. Unit tests and the local stack do not need it.
TONCENTER_BASE_URL=https://indexer.example.invalid
TONCENTER_API_KEY=change-me
